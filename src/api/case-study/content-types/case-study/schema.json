{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "banner": {
      "type": "component",
      "component": "global.banner",
      "repeatable": false
    },
    "contentBlock": {
      "type": "component",
      "component": "case-study.content-block",
      "repeatable": true
    },
    "showcase": {
      "type": "component",
      "component": "case-study.showcase",
      "repeatable": false
    },
    "testimonial": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::testimonial.testimonial"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "case-study.seo",
        "case-study.creatives"
      ]
    }
  }
}
